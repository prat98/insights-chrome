# Build galaxy_ng from source that was cloned into the hub-dev-env image
FROM hub-dev-env:latest AS source
FROM python:3.11-slim
RUN apt-get update && apt-get install -y gcc libpq-dev git libldap2-dev libsasl2-dev && rm -rf /var/lib/apt/lists/*
COPY --from=source /workspace/galaxy_ng /app
WORKDIR /app

# Install galaxy_ng and its dependencies
RUN pip install --no-cache-dir -e .

# Set up required certs and keys (from dev/compose)
RUN mkdir -p /etc/pulp/certs /var/lib/pulp/scripts /etc/pulp/gnupg && \
    cp /app/dev/compose/database/database_fields.symmetric.key /etc/pulp/certs/ && \
    cp /app/dev/compose/signing/keys/* /etc/pulp/certs/ && \
    cp /app/dev/compose/signing/scripts/* /var/lib/pulp/scripts/ && \
    chmod -R 0775 /etc/pulp/certs /var/lib/pulp/scripts

# Install the settings file
RUN cp /app/docker/etc/settings.py /etc/pulp/settings.py

# Install startup scripts
RUN install -Dm 0755 /app/docker/bin/start-api /app/docker/bin/start-content-app /app/docker/bin/start-worker /app/docker/bin/wait-for-migrations /app/docker/bin/wait-for-tcp /usr/local/bin/
